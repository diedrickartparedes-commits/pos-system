generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique @db.VarChar(80)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at")
}

model Product {
  id          Int        @id @default(autoincrement())
  name        String     @db.VarChar(150)
  price       Decimal    @db.Decimal(12, 2)
  gst         Decimal    @default(0) @db.Decimal(5, 2)
  taxExempt   Boolean    @default(false) @map("tax_exempt")
  stock       Int        @default(0)
  image       String?    @db.VarChar(255)
  description String?
  sku         String?    @unique @db.VarChar(80)
  cost        Decimal?   @db.Decimal(12, 2)
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  saleItems   SaleItem[]
  adjustments InventoryAdjustment[]
  @@index([name])
  @@index([active, stock])
  @@map("products")
}

model Sale {
  id           Int        @id @default(autoincrement())
  subtotal     Decimal?   @db.Decimal(12, 2)
  gstTotal     Decimal?   @map("gst_total") @db.Decimal(12, 2)
  total        Decimal    @db.Decimal(12, 2)
  createdAt    DateTime   @default(now()) @map("created_at")
  saleDate     DateTime   @default(now()) @map("sale_date")
  cash         Decimal?   @db.Decimal(12, 2)
  changeAmount Decimal?   @map("change_amount") @db.Decimal(12, 2)
  gst          Decimal    @default(0) @db.Decimal(5, 2)
  customerName String?    @map("customer_name") @db.VarChar(120)
  customerNote String?    @map("customer_note")
  idempotencyKey String?  @unique @map("idempotency_key") @db.VarChar(100)
  imported     Boolean    @default(false)
  items        SaleItem[]
  @@index([saleDate])
  @@index([createdAt])
  @@map("sales")
}

model SaleItem {
  id         Int      @id @default(autoincrement())
  saleId     Int      @map("sale_id")
  productId  Int?     @map("product_id")
  productName String  @map("product_name") @db.VarChar(150)
  productNameInferred Boolean @default(false) @map("product_name_inferred")
  taxExempt  Boolean  @default(false) @map("tax_exempt")
  qty        Int
  price      Decimal  @db.Decimal(12, 2)
  gst        Decimal  @default(0) @db.Decimal(12, 2)
  subtotal   Decimal  @db.Decimal(12, 2)
  discount   Decimal  @default(0) @db.Decimal(12, 2)
  gstRate    Decimal  @default(0) @map("gst_rate") @db.Decimal(5, 2)
  sale       Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product    Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  @@index([saleId])
  @@map("sale_items")
}

model InventoryAdjustment {
  id        Int      @id @default(autoincrement())
  productId Int      @map("product_id")
  delta     Int
  reason    String   @db.VarChar(240)
  createdAt DateTime @default(now()) @map("created_at")
  product   Product  @relation(fields: [productId], references: [id])
  @@index([productId, createdAt])
  @@map("inventory_adjustments")
}

model CashDrawer {
  id         Int      @id @default(autoincrement())
  opening    Decimal? @db.Decimal(12, 2)
  closing    Decimal? @db.Decimal(12, 2)
  expected   Decimal? @db.Decimal(12, 2)
  difference Decimal? @db.Decimal(12, 2)
  createdAt  DateTime @default(now()) @map("created_at")
  @@map("cash_drawer")
}

model EndOfDay {
  id           Int      @id @default(autoincrement())
  reportDate   DateTime? @map("report_date") @db.Date
  totalSales   Decimal? @map("total_sales") @db.Decimal(12, 2)
  cashReceived Decimal? @map("cash_received") @db.Decimal(12, 2)
  expectedCash Decimal? @map("expected_cash") @db.Decimal(12, 2)
  actualCash   Decimal? @map("actual_cash") @db.Decimal(12, 2)
  floatAmount  Decimal? @map("float_amount") @db.Decimal(12, 2)
  difference   Decimal? @db.Decimal(12, 2)
  createdAt    DateTime @default(now()) @map("created_at")
  @@index([reportDate])
  @@map("end_of_day")
}
